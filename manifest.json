{
  "manifest_version": 3,
  "name": "FocusLock — Study Guard",
  "version": "2.1.0",
  "description": "Timed focus sessions for students. Your study tabs stay open; Shorts, feeds and doomscroll sites wait until the session ends. 100% local, no account.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms", "notifications", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusLock — Study Guard"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["policy.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
